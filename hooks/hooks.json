{
  "description": "Muat aturan kerja inti noskill di awal sesi dan sarankan skill paling relevan berdasarkan intent prompt user",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh", "session-start"],
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/intent-router.sh"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
