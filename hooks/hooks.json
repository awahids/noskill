{
  "description": "Load noskill startup rules and context in a more superpower-like way",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|new",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh", "session-start"],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
